<?xml version="1.0" encoding="utf-8"?>
<!-- BlueOS music widget, 2x1: outline minimalist -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/blueos_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/blueos_media_art_bg"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/blueos_media_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/blueos_ic_music_note" />

            <ImageView
                android:id="@+id/blueos_media_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/blueos_media_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="google-sans-text-medium"
            android:maxLines="2"
            android:text="@string/blueos_media_widget_idle"
            android:textColor="@color/blueos_widget_on_surface"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/blueos_media_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/blueos_media_play_bg"
            android:contentDescription="@string/blueos_media_widget_play"
            android:padding="9dp"
            android:src="@drawable/blueos_ic_play"
            android:tint="@color/blueos_widget_on_primary" />
    </LinearLayout>
</FrameLayout>
