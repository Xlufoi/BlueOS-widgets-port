<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blueos_widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/blueos_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/blueos_widget_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/blueos_media_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:fontFamily="google-sans-text-medium"
            android:singleLine="true"
            android:text="Track Title"
            android:textColor="@color/blueos_widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blueos_media_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="google-sans-text"
            android:singleLine="true"
            android:text="Artist"
            android:textColor="@color/blueos_widget_on_surface_variant"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/blueos_media_art"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_marginVertical="6dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/blueos_ic_music_note" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/blueos_media_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:scaleType="centerInside"
                android:src="@drawable/blueos_ic_skip_previous"
                android:tint="@color/blueos_widget_on_surface" />

            <ImageView
                android:id="@+id/blueos_media_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/blueos_media_play_bg"
                android:contentDescription="Play/Pause"
                android:scaleType="centerInside"
                android:src="@drawable/blueos_ic_play" />

            <ImageView
                android:id="@+id/blueos_media_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:scaleType="centerInside"
                android:src="@drawable/blueos_ic_skip_next"
                android:tint="@color/blueos_widget_on_surface" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
