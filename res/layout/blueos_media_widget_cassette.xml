<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blueos_widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/blueos_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/blueos_widget_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Cassette Tape Header Label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#15FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="blueos-clock"
                android:fontVariationSettings="'wght' 700"
                android:text="SIDE A"
                android:textColor="@color/blueos_widget_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/blueos_media_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:fontFamily="google-sans-text-medium"
                android:singleLine="true"
                android:text="Track Title"
                android:textColor="@color/blueos_widget_on_surface"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/blueos_media_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="google-sans-text"
                android:singleLine="true"
                android:text="Artist"
                android:textColor="@color/blueos_widget_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Cassette Spools & Window -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/blueos_battery_ring"
                android:tint="@color/blueos_widget_primary" />

            <ImageView
                android:id="@+id/blueos_media_art"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="20dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/blueos_ic_music_note" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/blueos_battery_ring"
                android:tint="@color/blueos_widget_primary" />
        </LinearLayout>

        <!-- Progress bar & time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/blueos_media_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans-text"
                android:text="0:00"
                android:textColor="@color/blueos_widget_on_surface_variant"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/blueos_media_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="350"
                android:progressDrawable="@drawable/blueos_media_progress" />

            <TextView
                android:id="@+id/blueos_media_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans-text"
                android:text="3:45"
                android:textColor="@color/blueos_widget_on_surface_variant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/blueos_media_previous"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:scaleType="centerInside"
                android:src="@drawable/blueos_ic_skip_previous"
                android:tint="@color/blueos_widget_on_surface" />

            <ImageView
                android:id="@+id/blueos_media_play_pause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/blueos_media_play_bg"
                android:contentDescription="Play/Pause"
                android:scaleType="centerInside"
                android:src="@drawable/blueos_ic_play" />

            <ImageView
                android:id="@+id/blueos_media_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:scaleType="centerInside"
                android:src="@drawable/blueos_ic_skip_next"
                android:tint="@color/blueos_widget_on_surface" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
