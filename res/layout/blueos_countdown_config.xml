<?xml version="1.0" encoding="utf-8"?>
<!-- BlueOS countdown widget setup: what to count down to and when -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="google-sans"
            android:text="@string/blueos_countdown_widget"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <EditText
            android:id="@+id/blueos_countdown_title_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/blueos_countdown_title_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="60" />

        <DatePicker
            android:id="@+id/blueos_countdown_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:datePickerMode="calendar" />

        <Switch
            android:id="@+id/blueos_countdown_yearly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/blueos_countdown_yearly" />

        <Button
            android:id="@+id/blueos_countdown_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="@string/blueos_countdown_done" />
    </LinearLayout>
</ScrollView>
