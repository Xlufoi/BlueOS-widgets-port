<?xml version="1.0" encoding="utf-8"?>
<!-- BlueOS music widget: art, title, artist, progress, previous / play-pause / next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blueos_widget_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/blueos_media_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/blueos_media_art_bg"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/blueos_ic_music_note" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/blueos_media_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/blueos_media_widget_idle"
                android:textColor="@color/blueos_widget_on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/blueos_media_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/blueos_widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/blueos_media_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="1000"
        android:progressDrawable="@drawable/blueos_media_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.75"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/blueos_media_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="google-sans-text"
            android:textColor="@color/blueos_widget_on_surface_variant"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/blueos_media_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="google-sans-text"
            android:gravity="end"
            android:textColor="@color/blueos_widget_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/blueos_media_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/blueos_media_widget_previous"
            android:padding="8dp"
            android:src="@drawable/blueos_ic_skip_previous" />

        <ImageView
            android:id="@+id/blueos_media_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/blueos_media_play_bg"
            android:contentDescription="@string/blueos_media_widget_play"
            android:padding="10dp"
            android:src="@drawable/blueos_ic_play" />

        <ImageView
            android:id="@+id/blueos_media_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/blueos_media_widget_next"
            android:padding="8dp"
            android:src="@drawable/blueos_ic_skip_next" />
    </LinearLayout>
</LinearLayout>
