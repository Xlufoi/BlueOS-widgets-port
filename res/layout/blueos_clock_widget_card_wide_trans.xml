<?xml version="1.0" encoding="utf-8"?>
<!-- BlueOS wide clock widget: transparent minimalist floating on wallpaper -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/blueos_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/blueos_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="blueos-clock"
                android:fontVariationSettings="'wght' 600"
                android:format12Hour="h"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/blueos_colon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="blueos-clock"
                android:fontVariationSettings="'wght' 600"
                android:includeFontPadding="false"
                android:text=":"
                android:textColor="#FFFFFF"
                android:textSize="44sp" />

            <TextClock
                android:id="@+id/blueos_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="blueos-clock"
                android:fontVariationSettings="'wght' 600"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#38BDF8"
                android:textSize="44sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/blueos_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, d MMM"
                android:format24Hour="EEE, d MMM"
                android:singleLine="true"
                android:textColor="#CBD5E1"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/blueos_alarm_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alarm"
                    android:tint="#CBD5E1" />

                <TextView
                    android:id="@+id/blueos_next_alarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:text="07:00"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
