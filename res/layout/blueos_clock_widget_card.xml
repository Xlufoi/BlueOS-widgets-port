<?xml version="1.0" encoding="utf-8"?>
<!-- BlueOS clock widget A: time (minutes in the accent color), date and next alarm on a card -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blueos_widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/blueos_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/blueos_widget_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/blueos_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="blueos-clock"
                android:fontVariationSettings="'wght' 600"
                android:format12Hour="h"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/blueos_widget_on_surface"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/blueos_colon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="blueos-clock"
                android:fontVariationSettings="'wght' 600"
                android:includeFontPadding="false"
                android:text=":"
                android:textColor="@color/blueos_widget_on_surface"
                android:textSize="40sp" />

            <TextClock
                android:id="@+id/blueos_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="blueos-clock"
                android:fontVariationSettings="'wght' 600"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/blueos_widget_primary"
                android:textSize="40sp" />
        </LinearLayout>

        <TextClock
            android:id="@+id/blueos_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="google-sans-text"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:singleLine="true"
            android:textColor="@color/blueos_widget_on_surface_variant"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/blueos_alarm_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_alarm"
                android:tint="@color/blueos_widget_on_surface_variant" />

            <TextView
                android:id="@+id/blueos_next_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans-text"
                android:singleLine="true"
                android:text="07:00"
                android:textColor="@color/blueos_widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
