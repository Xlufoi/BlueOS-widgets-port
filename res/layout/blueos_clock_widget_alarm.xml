<?xml version="1.0" encoding="utf-8"?>
<!-- BlueOS next alarm widget: icon, time, day; tap opens the alarms -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blueos_widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/blueos_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/blueos_widget_card_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_alarm"
            android:tint="@color/blueos_widget_on_primary_container" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/blueos_alarm_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="blueos-clock"
                android:fontVariationSettings="'wght' 600"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="07:00"
                android:textColor="@color/blueos_widget_on_primary_container"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/blueos_alarm_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.8"
                android:ellipsize="end"
                android:fontFamily="google-sans-text"
                android:singleLine="true"
                android:text="@string/blueos_countdown_today"
                android:textColor="@color/blueos_widget_on_primary_container"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
