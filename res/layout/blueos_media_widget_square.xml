<?xml version="1.0" encoding="utf-8"?>
<!-- BlueOS music widget, 2x2: the art fills it, the title on a scrim, play / pause in a corner -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blueos_widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/blueos_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/blueos_widget_card" />

    <ImageView
        android:id="@+id/blueos_media_placeholder"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:contentDescription="@null"
        android:src="@drawable/blueos_ic_music_note" />

    <ImageView
        android:id="@+id/blueos_media_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/blueos_media_scrim"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/blueos_media_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/blueos_media_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="google-sans-text-medium"
                android:maxLines="2"
                android:text="@string/blueos_media_widget_idle"
                android:textColor="@color/blueos_widget_on_primary_container"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/blueos_media_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:fontFamily="google-sans-text"
                android:singleLine="true"
                android:textColor="@color/blueos_widget_on_primary_container"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/blueos_media_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/blueos_media_play_bg"
            android:contentDescription="@string/blueos_media_widget_play"
            android:padding="10dp"
            android:src="@drawable/blueos_ic_play"
            android:tint="@color/blueos_widget_on_primary" />
    </LinearLayout>
</FrameLayout>
