<?xml version="1.0" encoding="utf-8"?>
<!-- BlueOS battery widget: charge ring (progress drawable), starting at the top -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape
            android:innerRadiusRatio="2.6"
            android:shape="ring"
            android:thicknessRatio="9"
            android:useLevel="false">
            <solid android:color="@color/blueos_widget_primary_container" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="270">
            <shape
                android:innerRadiusRatio="2.6"
                android:shape="ring"
                android:thicknessRatio="9"
                android:useLevel="true">
                <solid android:color="@color/blueos_widget_primary" />
            </shape>
        </rotate>
    </item>
</layer-list>
