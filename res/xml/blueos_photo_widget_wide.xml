<!-- BlueOS photo widget: wide (4x2); all sizes resize freely -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="org.lineageos.glimpse.widgets.BlueOSPhotoConfigActivity"
    android:description="@string/blueos_photo_widget_description"
    android:initialLayout="@layout/blueos_photo_widget_rounded"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/blueos_photo_widget_rounded"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
