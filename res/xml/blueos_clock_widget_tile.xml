<?xml version="1.0" encoding="utf-8"?>
<!-- BlueOS clock widget C (2x2 tile) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/blueos_clock_widget_tile_description"
    android:initialLayout="@layout/blueos_clock_widget_tile"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/blueos_clock_widget_tile"
